# --- Supabase ---
# Panel del proyecto: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Service role key: SOLO se usa en el servidor (webhook de Mercado Pago). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Mercado Pago ---
# Credenciales de producción o de prueba: https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=tu-access-token
# Se usa para validar la firma del webhook (Panel > Webhooks > Firma secreta)
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret
# Precio mensual del plan Premium en la moneda de tu cuenta MP (ej. ARS, MXN, COP)
MERCADOPAGO_PREMIUM_PRICE=4900
MERCADOPAGO_CURRENCY=ARS

# --- Resend ---
# https://resend.com/api-keys
RESEND_API_KEY=tu-resend-api-key
RESEND_FROM_EMAIL="Productividad <onboarding@tu-dominio.com>"

# --- App ---
# URL pública donde se despliega la app (Vercel la define automáticamente en prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000
